# Local development only. Do not put production or shared credentials here.
FLOWPLANE_HTTP_PORT=8080
FLOWPLANE_POSTGRES_PORT=5432
FLOWPLANE_KEYCLOAK_PORT=8081

# Match these values to `id -u` and `id -g` in WSL before building frontend-dev.
FLOWPLANE_UID=1000
FLOWPLANE_GID=1000

# Optional A-09 built-in secret-store root certificate. The referenced PFX is
# generated locally, ignored by Git, and mounted only by compose.secrets.yaml.
FLOWPLANE_SECRET_ROOT_CERTIFICATE_FILE=./secrets/flowplane-root.pfx

FLOWPLANE_POSTGRES_USER=flowplane
FLOWPLANE_POSTGRES_PASSWORD=flowplane-local-development-only
FLOWPLANE_POSTGRES_DB=flowplane

FLOWPLANE_KEYCLOAK_ADMIN=admin
FLOWPLANE_KEYCLOAK_ADMIN_PASSWORD=keycloak-local-development-only
FLOWPLANE_KEYCLOAK_TEST_USERNAME=flowplane-developer
FLOWPLANE_KEYCLOAK_TEST_PASSWORD=flowplane-developer-local-only
