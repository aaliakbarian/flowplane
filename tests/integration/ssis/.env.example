# A-10 controlled external SSISDB integration tests only. Never commit the populated .env file.
FLOWPLANE_TEST_SSIS_HOST=
FLOWPLANE_TEST_SSIS_PORT=1433
FLOWPLANE_TEST_SSIS_TRUST_SERVER_CERTIFICATE=false

FLOWPLANE_TEST_SSIS_VALID_USERNAME=
FLOWPLANE_TEST_SSIS_VALID_PASSWORD=

FLOWPLANE_TEST_SSIS_READONLY_USERNAME=
FLOWPLANE_TEST_SSIS_READONLY_PASSWORD=

FLOWPLANE_TEST_SSIS_NO_OBJECT_PERMISSION_USERNAME=
FLOWPLANE_TEST_SSIS_NO_OBJECT_PERMISSION_PASSWORD=

# Optional controlled negative cases.
FLOWPLANE_TEST_SSIS_NO_CATALOG_ACCESS_USERNAME=
FLOWPLANE_TEST_SSIS_NO_CATALOG_ACCESS_PASSWORD=
FLOWPLANE_TEST_SSIS_TLS_FAILURE_USERNAME=
FLOWPLANE_TEST_SSIS_TLS_FAILURE_PASSWORD=
